# ============================================================================
# Health Colombia ETL (ODS 3) — Environment template
# Copy to .env and adjust values. NEVER commit the real .env file.
#   cp .env.example .env
# ============================================================================

# --- PostgreSQL 16 (Data Warehouse) ---
POSTGRES_DB=salud_colombia
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=change_me_2026
POSTGRES_PORT=5432
PGDATA_HOST_DIR=./.pgdata

# --- Application DB connection (used by src/config.py inside containers) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salud_colombia
DB_USER=etl_user
DB_PASSWORD=change_me_2026

# --- Apache Airflow 3.1.8 ---
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_WEBSERVER_SECRET_KEY=change_me_airflow_secret_2026
AIRFLOW_DB=airflow_meta

# --- PostgREST ---
POSTGREST_PORT=3000
POSTGREST_DB_SCHEMA=public
POSTGREST_DB_ANON_ROLE=etl_user

# --- Apache Superset (batch analytical dashboard) ---
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@saludcolombia.gov.co
SUPERSET_SECRET_KEY=change_me_superset_secret_2026
MAPBOX_API_KEY=

# --- Apache Kafka (streaming) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=salud.metric.updates
KAFKA_DLQ_TOPIC=salud.metric.dlq
KAFKA_CLIENT_ID=health-colombia-streaming

# --- Streaming producer / consumer ---
STREAMING_PRODUCER_MODE=snapshot      # snapshot | replay (replay = simulation)
STREAMING_PRODUCER_INTERVAL=10        # seconds between DW change checks
STREAMING_CONSUMER_GROUP=health-metrics-consumers
STREAMING_CONSUMER_ID=consumer-1

# --- Real-time dashboard (Streamlit) ---
REALTIME_DASHBOARD_PORT=8501
