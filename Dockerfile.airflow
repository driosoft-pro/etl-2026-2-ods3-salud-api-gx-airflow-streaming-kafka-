# Airflow conserva su versión y constraints; todas las versiones del proyecto
# se declaran en requirements.txt. El bloque GENERAL_ONLY corresponde al
# dashboard y notebook y se excluye de esta imagen para preservar protobuf 4.
FROM docker.io/apache/airflow:3.1.8
USER airflow
COPY requirements.txt /requirements.txt
RUN python3 -c "from pathlib import Path; s=Path('/requirements.txt').read_text(); Path('/tmp/requirements-airflow.txt').write_text(''.join(line for line in (s.split('# BEGIN GENERAL_ONLY')[0] + s.split('# END GENERAL_ONLY')[1]).splitlines(True) if not line.startswith('chardet==')))" \
    && python3 -m pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" \
       --constraint /home/airflow/constraints.txt -r /tmp/requirements-airflow.txt \
    && python3 -m pip install --no-cache-dir "$(sed -n '/^chardet==/p' /requirements.txt)" \
    && python3 -m pip check \
    && python3 -c "import great_expectations, kafka, requests; print('Airflow dependencies OK')"
